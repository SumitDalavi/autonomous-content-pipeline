# .env.example — autonomous-content-pipeline
# Copy to .env and fill in values to activate live backends. Leave blank for mock mode.
#
# ┌─────────────────────────────────────────────────────────────────────────┐
# │  PROGRESSIVE CREDENTIAL LOADING (PCL)                                   │
# │  No keys needed to run. Add keys to unlock production-grade backends.   │
# └─────────────────────────────────────────────────────────────────────────┘

# ── AI Providers ─────────────────────────────────────────────────────────
# UNSET or sk-dummy (default): Offline rule-based heuristic writer & editor (CI-safe)
# SET to OpenAI key (sk-...): Live GPT-4o-mini generation and critical evaluation
OPENAI_API_KEY=

# ── Search Tools ──────────────────────────────────────────────────────────
# UNSET (default): Fallback search provider
# SET to Tavily key: Live web search for real-time article synthesis
TAVILY_API_KEY=

# ── Configuration ─────────────────────────────────────────────────────────
QUALITY_THRESHOLD=0.80
OUTPUT_DIR=output
PORT=8000
